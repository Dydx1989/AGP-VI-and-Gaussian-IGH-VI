for (pp in p_grid) {
cat("\n========================================\n")
cat("Simulation for p =", pp, "\n")
cat("========================================\n")
vi_max_iter <- ifelse(pp >= 300, 250, 300)
for (rr in seq_len(n_rep)) {
cat("Replication", rr, "of", n_rep, "\n")
# ------------------------------------------------------------------------
# Generate data
# ------------------------------------------------------------------------
simulated_data <- simulate_cox_data(
n = n,
p = pp,
n_signal = n_signal,
rho = rho,
beta_value = beta_value,
censoring_rate = censoring_rate,
seed = 100000 + pp * 100 + rr
)
split_data <- train_test_split(
X = simulated_data$X,
time = simulated_data$time,
status = simulated_data$status,
train_fraction = train_fraction,
seed = 200000 + pp * 100 + rr
)
eval_time <- if (
sum(split_data$status_train == 1) > 0
) {
as.numeric(
quantile(
split_data$time_train[
split_data$status_train == 1
],
0.50
)
)
} else {
median(split_data$time_train)
}
# ------------------------------------------------------------------------
# Cox-Lasso
# ------------------------------------------------------------------------
start_time <- proc.time()[3]
fit_cox_lasso_object <- tryCatch(
fit_cox_lasso(
X = split_data$X_train,
time = split_data$time_train,
status = split_data$status_train
),
error = function(e) {
warning(
"Cox-Lasso failed: ",
conditionMessage(e)
)
list(
method = "Cox-Lasso",
beta = rep(NA_real_, pp)
)
}
)
time_cox_lasso <- proc.time()[3] - start_time
result_cox_lasso <- evaluate_model(
fit = fit_cox_lasso_object,
X_train = split_data$X_train,
time_train = split_data$time_train,
status_train = split_data$status_train,
X_test = split_data$X_test,
time_test = split_data$time_test,
status_test = split_data$status_test,
beta_true = simulated_data$beta_true,
eval_time = eval_time,
threshold = absolute_threshold,
z_threshold = z_threshold
)
result_cox_lasso$Time_s <- time_cox_lasso
# ------------------------------------------------------------------------
# Horseshoe-Cox
# ------------------------------------------------------------------------
start_time <- proc.time()[3]
fit_horseshoe_object <- tryCatch(
fit_horseshoe_cox(
X = split_data$X_train,
time = split_data$time_train,
status = split_data$status_train,
chains = horseshoe_chains,
iter = horseshoe_iter,
warmup = horseshoe_warmup,
seed = 300000 + pp * 100 + rr
),
error = function(e) {
warning(
"Horseshoe-Cox failed: ",
conditionMessage(e)
)
list(
method = "Horseshoe-Cox",
beta = rep(NA_real_, pp)
)
}
)
time_horseshoe <- proc.time()[3] - start_time
result_horseshoe <- evaluate_model(
fit = fit_horseshoe_object,
X_train = split_data$X_train,
time_train = split_data$time_train,
status_train = split_data$status_train,
X_test = split_data$X_test,
time_test = split_data$time_test,
status_test = split_data$status_test,
beta_true = simulated_data$beta_true,
eval_time = eval_time,
threshold = absolute_threshold,
z_threshold = z_threshold
)
result_horseshoe$Time_s <- time_horseshoe
# ------------------------------------------------------------------------
# AGP-VI
# ------------------------------------------------------------------------
start_time <- proc.time()[3]
fit_agp_object <- tryCatch(
fit_agp_vi(
X = split_data$X_train,
time = split_data$time_train,
status = split_data$status_train,
max_iter = vi_max_iter,
eta = 0.001,
tol = 1e-4,
init_var = 0.5,
min_var = 1e-4,
max_var = 5,
ridge = 0.05,
grad_clip = 5,
block_size = 5,
corr_shrinkage = 0.3,
verbose = FALSE
),
error = function(e) {
warning(
"AGP-VI failed: ",
conditionMessage(e)
)
list(
method = "AGP-VI",
beta = rep(NA_real_, pp),
covariance = diag(NA_real_, pp),
elbo = numeric()
)
}
)
time_agp <- proc.time()[3] - start_time
result_agp <- evaluate_model(
fit = fit_agp_object,
X_train = split_data$X_train,
time_train = split_data$time_train,
status_train = split_data$status_train,
X_test = split_data$X_test,
time_test = split_data$time_test,
status_test = split_data$status_test,
beta_true = simulated_data$beta_true,
eval_time = eval_time,
threshold = absolute_threshold,
z_threshold = z_threshold
)
result_agp$Time_s <- time_agp
# ------------------------------------------------------------------------
# Gaussian--IGH-VI
# ------------------------------------------------------------------------
start_time <- proc.time()[3]
fit_igh_object <- tryCatch(
fit_igh_vi(
X = split_data$X_train,
time = split_data$time_train,
status = split_data$status_train,
a = 1,
b = 2,
max_iter = vi_max_iter,
eta = 0.001,
tol = 1e-4,
init_var = 1,
min_var = 1e-3,
max_var = 5,
ridge = 0.01,
grad_clip = 5,
block_size = 5,
corr_shrinkage = 0.3,
signal_threshold = 0.05,
escape_factor = 8,
warm_start = TRUE,
verbose = FALSE
),
error = function(e) {
warning(
"Gaussian--IGH-VI failed: ",
conditionMessage(e)
)
list(
method = "Gaussian--IGH-VI",
beta = rep(NA_real_, pp),
covariance = diag(NA_real_, pp),
elbo = numeric()
)
}
)
time_igh <- proc.time()[3] - start_time
result_igh <- evaluate_model(
fit = fit_igh_object,
X_train = split_data$X_train,
time_train = split_data$time_train,
status_train = split_data$status_train,
X_test = split_data$X_test,
time_test = split_data$time_test,
status_test = split_data$status_test,
beta_true = simulated_data$beta_true,
eval_time = eval_time,
threshold = absolute_threshold,
z_threshold = z_threshold
)
result_igh$Time_s <- time_igh
# ------------------------------------------------------------------------
# Improved Tempered GL-Blended Gaussian--IGH-VI
# ------------------------------------------------------------------------
start_time <- proc.time()[3]
fit_gl_igh_object <- tryCatch(
fit_gl_blended_igh_vi(
X = split_data$X_train,
time = split_data$time_train,
status = split_data$status_train,
a = 1,
b = 0.5,
a0 = 1,
b0 = 2,
blend_weight = 0.90,
max_iter = vi_max_iter,
eta = 0.001,
tol = 1e-4,
init_var = 0.5,
min_var = 1e-4,
max_var = 5,
min_global_var = 0.05,
max_global_var = 10,
ridge = 0.04,
grad_clip = 5,
block_size = 10,
corr_shrinkage = 0.3,
verbose = FALSE
),
error = function(e) {
warning(
"Improved Tempered GL-Blended Gaussian--IGH-VI failed: ",
conditionMessage(e)
)
list(
method = "Improved Tempered GL-Blended Gaussian--IGH-VI",
beta = rep(NA_real_, pp),
covariance = diag(NA_real_, pp),
tau2 = rep(NA_real_, pp),
tau0_2 = NA_real_,
effective_var = rep(NA_real_, pp),
elbo = numeric()
)
}
)
time_gl_igh <- proc.time()[3] - start_time
result_gl_igh <- evaluate_model(
fit = fit_gl_igh_object,
X_train = split_data$X_train,
time_train = split_data$time_train,
